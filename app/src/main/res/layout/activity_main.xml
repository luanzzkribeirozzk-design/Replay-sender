<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_devwill"
        android:scaleType="centerCrop"
        android:alpha="0.35" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="46dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEV WILL TECH"
                android:textColor="#0A84FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviador"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvShellStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verificando acesso…"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- ABAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:background="@drawable/ios_tab_bar"
            android:padding="3dp">

            <Button
                android:id="@+id/tabPermissao"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Acesso"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/ios_tab_selected"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/tabPareamento"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Parear"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8E8E93"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/tabEnviar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Enviar"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8E8E93"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- SECAO PERMISSAO -->
                <LinearLayout
                    android:id="@+id/secPermissao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/ios_card"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Esse app precisa de acesso root ou Shizuku pra ler os replays salvos do Free Fire nesse aparelho."
                            android:textColor="#E0E0E5"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginBottom="16dp" />

                        <Button
                            android:id="@+id/btnSolicitarRoot"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Verificar acesso root"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/ios_btn_primary"
                            android:stateListAnimator="@null" />

                        <Button
                            android:id="@+id/btnSolicitarShizuku"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Abrir / solicitar Shizuku"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/ios_btn_secondary"
                            android:stateListAnimator="@null"
                            android:layout_marginTop="10dp" />

                        <Button
                            android:id="@+id/btnSolicitarArquivos"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Permitir acesso a arquivos"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/ios_btn_secondary"
                            android:stateListAnimator="@null"
                            android:layout_marginTop="10dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- SECAO PAREAMENTO -->
                <LinearLayout
                    android:id="@+id/secPareamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/ios_card"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gere um código e informe no app do celular pra parear os dois aparelhos."
                            android:textColor="#E0E0E5"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginBottom="16dp" />

                        <Button
                            android:id="@+id/btnGerarCodigo"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Gerar código de pareamento"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/ios_btn_primary"
                            android:stateListAnimator="@null" />

                        <LinearLayout
                            android:id="@+id/boxCodigo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/ios_input"
                            android:padding="20dp"
                            android:layout_marginTop="16dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CÓDIGO DE PAREAMENTO"
                                android:textColor="#8E8E93"
                                android:textSize="10.5sp"
                                android:letterSpacing="0.1" />

                            <TextView
                                android:id="@+id/tvCodigo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="------"
                                android:textColor="#0A84FF"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.12"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/btnCopiarCodigo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Copiar código"
                                android:textColor="#0A84FF"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:layout_marginTop="6dp" />

                            <TextView
                                android:id="@+id/tvCodigoExpira"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="expira em 10 min"
                                android:textColor="#8E8E93"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/boxConectado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/ios_card"
                        android:padding="18dp"
                        android:layout_marginTop="14dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/ios_pill_ok"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● Conectado"
                                android:textColor="#34C759"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDispositivoModelo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:layout_marginTop="10dp" />

                        <Button
                            android:id="@+id/btnDesparear"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Desparear"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/ios_btn_danger"
                            android:stateListAnimator="@null"
                            android:layout_marginTop="14dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- SECAO ENVIAR (FFM + FFN juntos) -->
                <LinearLayout
                    android:id="@+id/secEnviar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/ios_card"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Envia o replay mais recente do Free Fire instalado nesse aparelho pro aparelho pareado."
                            android:textColor="#E0E0E5"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginBottom="16dp" />

                        <Button
                            android:id="@+id/btnEnviarFFM"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:text="Enviar replay FF MAX"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/ios_btn_primary"
                            android:stateListAnimator="@null" />

                        <Button
                            android:id="@+id/btnEnviarFFN"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:text="Enviar replay FF Normal"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/ios_btn_secondary"
                            android:stateListAnimator="@null"
                            android:layout_marginTop="10dp" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </ScrollView>

        <!-- LOGS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:background="@drawable/ios_card"
            android:layout_margin="16dp"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Logs"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLimparLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limpar"
                    android:textColor="#0A84FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="4dp" />

            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollLog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text=""
                    android:textColor="#C7C7CC"
                    android:textSize="10.5sp"
                    android:lineSpacingExtra="2dp" />

            </ScrollView>

        </LinearLayout>

    </LinearLayout>

    <!-- OVERLAY AGUARDE -->
    <FrameLayout
        android:id="@+id/overlayAguarde"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/ios_card"
            android:padding="26dp">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="#0A84FF"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvAguarde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviando replay…"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
